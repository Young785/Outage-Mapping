# =============================================================================
# Storm Response Platform — Environment (Development vs Production)
# =============================================================================
# Copy to .env.local (recommended for Next.js) or .env
#
# APP_ENV picks which *_DEV or *_PROD block is active:
#   development → uses *_DEV keys (local Supabase / local Postgres)
#   production  → uses *_PROD keys (hosted Supabase)
# =============================================================================

APP_ENV=development

# -----------------------------------------------------------------------------
# DEFAULT LOGIN (after you run supabase/seed.sql on local DB — all use password123)
#   owner@outage-mapping.com   owner
#   admin@outage-mapping.com   admin
#   office@outage-mapping.com  office
#   tech@outage-mapping.com    tech (hunter)
#   tech2@ / tech3@            hunters
#   seller@                    seller dispatch role
#   installer@                 installer dispatch role
#   finisher@                  finisher dispatch role
# Or use "Create account" on the login screen if seed was not run.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# DEVELOPMENT — local database (Supabase CLI: `supabase start`)
# Browse tables: http://127.0.0.1:54323 (Supabase Studio — like phpMyAdmin for Postgres)
# Direct Postgres: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# -----------------------------------------------------------------------------
SUPABASE_URL_DEV=http://127.0.0.1:54321
SUPABASE_ANON_KEY_DEV=your-local-anon-key-from-supabase-status
SUPABASE_SERVICE_ROLE_KEY_DEV=your-local-service-role-key-from-supabase-status
DATABASE_URL_DEV=postgresql://postgres:postgres@127.0.0.1:54322/postgres
JWT_SECRET_DEV=local-dev-jwt-secret-min-32-chars

# -----------------------------------------------------------------------------
# PRODUCTION — hosted Supabase project
# -----------------------------------------------------------------------------
SUPABASE_URL_PROD=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY_PROD=your-production-anon-key
SUPABASE_SERVICE_ROLE_KEY_PROD=your-production-service-role-key
DATABASE_URL_PROD=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
JWT_SECRET_PROD=use-a-long-random-secret-in-production

# -----------------------------------------------------------------------------
# Legacy fallbacks (optional — used if *_DEV / *_PROD not set)
# -----------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# JWT_SECRET=

# -----------------------------------------------------------------------------
# Google Maps (required for map + geocoding + traffic-aware routing)
# Enable "Routes API" on the same Google Cloud project.
# Optional server-only key (if you restrict the public key to browser origins):
# GOOGLE_ROUTES_API_KEY=
# -----------------------------------------------------------------------------
# After changing NEXT_PUBLIC_* vars you must rebuild: npm run build && restart the app.
# In Google Cloud Console, allow HTTP referrers: https://stormtrackertool.com/* and http://localhost:*
# Enable: Maps JavaScript API, Geocoding API, Places API, Routes API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# Outage data sources
# -----------------------------------------------------------------------------
XCEL_ARCGIS_URL=
# Connexus Energy outage layer (ArcGIS FeatureServer). Override if the layer URL changes.
CONNEXUS_ARCGIS_URL=https://services6.arcgis.com/tLxmfwKZGo8Ff5TR/arcgis/rest/services/OutagePro_WFL1/FeatureServer/0/query?where=1%3D1&outFields=*&returnGeometry=true&outSR=4326&f=json

# -----------------------------------------------------------------------------
# Cron (production fetch job)
# -----------------------------------------------------------------------------
CRON_SECRET=

# -----------------------------------------------------------------------------
# SMS (optional)
# -----------------------------------------------------------------------------
SMS_NOTIFICATIONS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# -----------------------------------------------------------------------------
# Housecall Pro (optional)
# -----------------------------------------------------------------------------
HOUSECALL_API_KEY=
HOUSECALL_WEBHOOK_SECRET=
HOUSECALL_API_BASE_URL=https://api.housecallpro.com
